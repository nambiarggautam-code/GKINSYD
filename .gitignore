!map/output/a1/tags-A1.csv
!map/output/a1/back-template-A1-single.pdf
!map/output/a1/back-template-A4-tiled.pdf
!map/output/a1/nfc-tag-checklist-A4.pdf
!map/output/a1/back-of-canvas-label.pdf

# OSM data and caches
*.osm.pbf
*.osm
map/osm/
map/cache/
osmdata/

